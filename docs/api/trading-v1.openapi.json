  "components": {
    "securitySchemes": {
      "operatorSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "operator_session",
        "description": "Design requirement only: server-verified operator session, Secure/HttpOnly/SameSite, CSRF checks, principal/account authorization. Broker login alone does not satisfy this requirement."
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": "TradingApi.v1"
          },
          "scope": {
            "const": "FOUNDATION_CAPABILITIES_NOT_RUNTIME_HEALTH"
          },
          "liveOrderPlacement": {
            "const": "DISABLED"
          },
          "paperOrderSubmission": {
            "const": "NOT_IMPLEMENTED"
          },
          "operationalReadiness": {
            "const": "NO_GO"
          },
          "seriesV2": {
            "const": "PROPOSED_NOT_ADOPTED"
          }
        },
        "required": [
          "schemaVersion",
          "scope",
          "liveOrderPlacement",
          "paperOrderSubmission",
          "operationalReadiness",
          "seriesV2"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": "TradingApi.v1"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "schemaVersion",
          "code",
          "correlationId"
        ]
      },
      "Instrument": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instrumentId": {
            "type": "string",
            "format": "uuid"
          },
          "exchange": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "referenceSnapshotHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "identityEvidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "instrumentId",
          "exchange",
          "symbol",
          "referenceSnapshotHash",
          "identityEvidenceHash"
        ]
      },
      "StrategyConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configurationVersion": {
            "const": "TradingStrategyConfiguration.v1"
          },
          "strategyId": {
            "type": "string",
            "minLength": 1
          },
          "strategyVersion": {
            "type": "string",
            "minLength": 1
          },
          "methodologyVersion": {
            "type": "string",
            "minLength": 1
          },
          "instrument": {
            "$ref": "#/components/schemas/Instrument"
          },
          "timeframe": {
            "enum": [
              "5minute"
            ]
          },
          "parameters": {
            "type": "object"
          },
          "entryConditions": {
            "type": "string",
            "minLength": 1
          },
          "exitConditions": {
            "type": "string",
            "minLength": 1
          },
          "stopLossFraction": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
          },
          "profitTargetFraction": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
          },
          "eodExitCalendarHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "completedCandlesOnly": {
            "const": true
          },
          "executionAuthorization": {
            "const": "NOT_AUTHORIZED"
          }
        },
        "required": [
          "configurationVersion",
          "strategyId",
          "strategyVersion",
          "methodologyVersion",
          "instrument",
          "timeframe",
          "parameters",
          "entryConditions",
          "exitConditions",
          "stopLossFraction",
          "profitTargetFraction",
          "eodExitCalendarHash",
          "completedCandlesOnly",
          "executionAuthorization"
        ]
      },
      "Evaluation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "$ref": "#/components/schemas/StrategyConfiguration"
          },
          "datasetHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "calendarHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evaluationTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "lastCompletedCandleTimestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "configuration",
          "datasetHash",
          "calendarHash",
          "evaluationTimestamp",
          "lastCompletedCandleTimestamp"
        ]
      },
      "Backtest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "configuration": {
            "$ref": "#/components/schemas/StrategyConfiguration"
          },
          "datasetHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "corporateActionProvenanceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "costModelHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "slippageModelHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "splitPolicyHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
