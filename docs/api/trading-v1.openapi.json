          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "x-idempotency": "Atomic PostgreSQL claim scoped by authenticated principal, operation, account and key; canonical payload digest; same payload returns original result; different payload 409; retain across restart. Authorization rechecked before replay response; no side effect before admission."
      }
