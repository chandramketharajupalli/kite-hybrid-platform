TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
EMERGENCY_STOP=true
SPRING_PROFILES_ACTIVE=development
# Development helper accepts 1-63 letters/digits/underscores, not starting with a digit.
DB_NAME=trading
DB_USER=trading
# Required local-only passwords; choose your own values. Never commit .env.
DB_PASSWORD=
REDIS_PASSWORD=
# Compose publishes fixed loopback ports. The helper derives Java's DB_URL.
# Optional Spring override when configuring Java independently:
# DB_URL=jdbc:postgresql://localhost:5432/trading
REDIS_HOST=localhost
REDIS_PORT=6379
# Opt in to official interactive authentication and profile/instrument reads.
KITE_REST_ENABLED=false
KITE_API_KEY=
KITE_API_SECRET=
# Register this exact URL in the Kite Connect developer console.
KITE_REDIRECT_URL=http://localhost:8080/api/broker/kite/auth/callback
# Base64 encoding of 32 random bytes. Generate once; keep the same key on restart.
# See README: Kite Authentication. Never commit a populated key.
KITE_TOKEN_ENCRYPTION_KEY=
# Optional legacy standalone diagnostics only; Spring authentication does not need it.
KITE_ACCESS_TOKEN=
