TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
EMERGENCY_STOP=true
SPRING_PROFILES_ACTIVE=development
# Development helper accepts 1-63 letters/digits/underscores, not starting with a digit.
DB_NAME=trading
DB_USER=trading
# Required local-only passwords; choose your own values. Never commit .env.
DB_PASSWORD=
REDIS_PASSWORD=
# Compose publishes fixed loopback ports. The helper derives Java's DB_URL.
# Optional Spring override when configuring Java independently:
# DB_URL=jdbc:postgresql://localhost:5432/trading
REDIS_HOST=localhost
REDIS_PORT=6379
# Read-only REST must be explicitly enabled; normal startup makes no Kite calls.
KITE_REST_ENABLED=false
KITE_API_KEY=
# Reserved for future request-token exchange; not needed for Phase 2 GETs.
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
