<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.kitehybrid</groupId>
    <artifactId>kite-hybrid-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>apps/trading-core</module>
    </modules>
    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <archunit.version>1.4.1</archunit.version>
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
        <test-byte-buddy.version>1.18.3</test-byte-buddy.version>
        <test-snakeyaml.version>2.5</test-snakeyaml.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.4</maven-failsafe-plugin.version>
        <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
        <skipUnitTests>false</skipUnitTests>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-jdk-21</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>Run Maven with an already installed JDK 21; set JAVA_HOME for this process only.</message>
                                </requireJavaVersion>
                                <requireFilesExist>
                                    <files><file>${java.home}/bin/javac${executable.extension}</file></files>
                                    <message>A full JDK 21 with javac is required. No JDK is downloaded by this build.</message>
                                </requireFilesExist>
                                <requireMavenVersion><version>[3.9.11,4)</version></requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>windows</id>
            <activation><os><family>Windows</family></os></activation>
            <properties><executable.extension>.exe</executable.extension></properties>
        </profile>
        <profile>
            <id>unix</id>
            <activation><os><family>unix</family></os></activation>
            <properties><executable.extension></executable.extension></properties>
        </profile>
    </profiles>
</project>
